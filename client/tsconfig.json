{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist-types",
    "outDir": "./dist-types"
  },
  "include": ["src"]
}
